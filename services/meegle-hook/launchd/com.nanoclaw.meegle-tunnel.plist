<plist version="1.0">
<dict>
  <key>Label</key><string>com.nanoclaw.meegle-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/admin/ai/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>/Users/admin/ai/nanoclaw/services/meegle-hook/cloudflared.yml</string>
    <string>--protocol</string>
    <string>http2</string>
    <string>run</string>
